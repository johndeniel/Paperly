# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# The public-facing URL for the application. Used to generate absolute URLs,
# configure OAuth redirect callbacks, and reference assets or endpoints
# across the application. Override in production to match your deployed domain.
# Example: https://app.example.com
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Connection string for the primary database. This URI includes the protocol,
# user credentials, host address, port, database name, and SSL mode settings.
# Ensure that credentials are secured and not checked into source control.
# Example: postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>?sslmode=require
NEXT_PUBLIC_DATABASE_URL=
